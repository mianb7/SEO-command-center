# ============================================================
# SEO COMMAND CENTER PRO — API KEYS SETUP
# ============================================================
# This app works WITHOUT any API keys (free on-page + technical data).
# Add the keys below to unlock REAL backlink, traffic, and ranking data.
# Total cost for everything: ~£0.80 (just the DataForSEO $1 trial).
# Moz, Zenserp, and ValueSERP are completely FREE.
# ============================================================

PORT=3000
NODE_ENV=development

# --------------------------------------------------
# 1. MOZ API — FREE (50 rows/month, NO credit card)
# What you get: Real Domain Authority, backlink count, spam score
# Sign up: https://moz.com/products/api/keys
# Paste your keys below (replace the example text):
# --------------------------------------------------
MOZ_ACCESS_ID=your_moz_access_id_here
MOZ_SECRET_KEY=your_moz_secret_key_here

# --------------------------------------------------
# 2. ZENSERP — FREE (50 searches/month, NO credit card)
# What you get: Real Google keyword rankings
# Sign up: https://app.zenserp.com
# Paste your key below:
# --------------------------------------------------
ZENSERP_API_KEY=your_zenserp_key_here

# --------------------------------------------------
# 3. VALUE SERP — FREE (100 searches/month, NO credit card)
# What you get: Backup real Google keyword rankings
# Sign up: https://valueserp.com
# Paste your key below:
# --------------------------------------------------
VALUESERP_API_KEY=your_valueserp_key_here

# --------------------------------------------------
# 4. DATAFORSEO — $1 TRIAL (~£0.80), then pay-as-you-go
# What you get: Real backlink counts, real traffic estimates, real keyword data
# Sign up: https://dataforseo.com
# Add $1 to your account, then paste credentials below:
# --------------------------------------------------
DATAFORSEO_LOGIN=your_dataforseo_email_here
DATAFORSEO_PASSWORD=your_dataforseo_api_password_here
